# JobPilot AI - Environment Configuration

# Application
APP_NAME=JobPilot AI
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security, PII Encryption & Authentication
SECRET_KEY=jobpilot_super_secret_jwt_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# 32-url-safe base64 Fernet key for field-level PII encryption at rest
PII_ENCRYPTION_KEY=v4kPZ4_JjMhQpT8nO2_s-UaX1f8wR-6vK9yE0zL_3pA=

# Database
# Default: SQLite (portable, zero-configuration local development)
DATABASE_URL=sqlite+aiosqlite:///./jobpilot.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobpilot

# Task Queue (ARQ on Redis)
REDIS_URL=redis://localhost:6379/0

# Storage Interface (Local or S3/MinIO/Cloudflare R2)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_NAME=jobpilot-vault
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1

# Observability & Logging
LOG_FORMAT=console
# LOG_FORMAT=json
# SENTRY_DSN=https://example@sentry.io/123456

# Legal Data Discovery & Scraping Guardrails
ENABLE_SCRAPING_SOURCES=false
GHOST_JOB_THRESHOLD_DAYS=45
GHOST_JOB_REPOST_THRESHOLD=3
RATE_LIMIT_DEFAULT=60/minute

# AI Provider Configuration
# Supported providers: built-in, openai, gemini, anthropic
AI_PROVIDER=built-in
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Email Notifications (Optional)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@jobpilot.ai

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=true
