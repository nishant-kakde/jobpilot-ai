# JobPilot AI - Environment Configuration

# Application
APP_NAME=JobPilot AI
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Authentication
SECRET_KEY=jobpilot_super_secret_jwt_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Default: SQLite (portable, zero-configuration local development)
DATABASE_URL=sqlite+aiosqlite:///./jobpilot.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobpilot

# AI Provider Configuration
# Supported providers: built-in, openai, gemini, anthropic
AI_PROVIDER=built-in
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Redis & Background Tasks (Optional)
REDIS_URL=redis://localhost:6379/0

# Email Notifications (Optional)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@jobpilot.ai

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=true
